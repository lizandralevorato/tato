# Copie para .env e ajuste. Sem .env, o projeto roda em modo desenvolvimento com SQLite.
# Produção (Docker/hospedagem): veja DEPLOY.md.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Se vazio, usa https:// + cada host de DJANGO_ALLOWED_HOSTS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://massagem.suaempresa.com.br
# DJANGO_SSL_REDIRECT=1
# DJANGO_LOG_LEVEL=INFO
# GUNICORN_WORKERS=3

# PostgreSQL: use DATABASE_URL (formato das hospedagens) OU as variáveis POSTGRES_*.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# POSTGRES_DB=massagem
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Notificações (Web Push). Gere com: python manage.py gerar_chaves_vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTATO=mailto:recepcao@suaempresa.com.br
